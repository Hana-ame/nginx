server {
    listen 443 ssl http2;
    listen [::]:443;
    server_name  v.moonchan.xyz;

    # ssl configuration
    include conf.d/ssl/moonchan.xyz.conf;

    include conf.d/addon/v2ray.conf;

#        # access_log /var/log/nginx/access.log;
#        error_log /var/log/nginx/error.log;

    location /tsuki/ { #/ray 路径需要和v2ray服务器端，客户端保持一致
        proxy_redirect off;
        proxy_pass http://127.0.0.1:8388; #此IP地址和端口需要和v2ray服务器保持一致，
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $http_host;
    }


     location / {
         root /var/www/html;
         autoindex on; #for enable directory listing 
         # proxy_set_header Host $host;
         # proxy_pass http://host.docker.internal:5500/;
     }

    # redirect server error pages to the static page /50x.html
    error_page   500 502 503 504  /50x.html;
    location = /50x.html {
        root   /usr/share/nginx/html;
    }
}
