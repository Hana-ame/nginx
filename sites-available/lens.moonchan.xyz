server {
    listen 443 ssl http2;
    server_name lens-google.moonchan.xyz apis-google.moonchan.xyz play-google.moonchan.xyz gstatic.moonchan.xyz fonts-gstatic.moonchan.xyz encrypted-tbn0-gstatic.moonchan.xyz encrypted-tbn1-gstatic.moonchan.xyz encrypted-tbn2-gstatic.moonchan.xyz encrypted-tbn3-gstatic.moonchan.xyz lh3-googleusercontent.moonchan.xyz lh2-googleusercontent.moonchan.xyz lh1-googleusercontent.moonchan.xyz lh0-googleusercontent.moonchan.xyz;

    # ssl configuration
    include /etc/nginx/conf.d/ssl/moonchan.xyz.conf;
    

    location / {
        proxy_set_header Host $host;
        proxy_pass http://127.0.3.1:8080/;
    }

    # redirect server error pages to the static page /50x.html
    error_page   500 502 503 504  /50x.html;
    location = /50x.html {
        root   /usr/share/nginx/html;
    }
}

server {
    listen 443 ssl http2;
    server_name lens.moonchan.xyz;

    # ssl configuration
    include /etc/nginx/conf.d/ssl/moonchan.xyz.conf;
    
    include /etc/nginx/conf.d/addon/no-log.conf;

    location / {
        try_files $uri $uri/ /len.html;
        root /var/www/moonchan;
    }

    # redirect server error pages to the static page /50x.html
    error_page   500 502 503 504  /50x.html;
    location = /50x.html {
        root   /usr/share/nginx/html;
    }
}