server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name  nyaa.moonchan.xyz nyaa.nmbyd1.top;

    # ssl configuration
    include /etc/nginx/conf.d/ssl/moonchan.xyz.conf;
    
    access_log /dev/null;
    error_log /dev/null;
     
    include /etc/nginx/conf.d/addon/general-deny.conf;


    location / {
        proxy_set_header Host $host;
        proxy_pass http://127.25.23.4:8080/;
    }

    location /static/js/bootstrap-select.min.js {
        alias /var/www/moonchan/static/js/bootstrap-select.min.js;
    }

    # redirect server error pages to the static page /50x.html
    error_page   500 502 503 504  /50x.html;
    location = /50x.html {
        root   /usr/share/nginx/html;
    }
}

