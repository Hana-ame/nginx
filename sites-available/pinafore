server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name  pinafore.moonchan.xyz;

    # ssl configuration
    include conf.d/ssl/moonchan.xyz.conf;

    include conf.d/addon/v2ray.conf;


    log_format custom '$remote_addr - $remote_user [$time_local] "$request" '
                  'http_x_cf_ipcountry=$http_x_cf_ipcountry endpoint=$endpoint uri=$uri block=$block ';

    access_log /var/log/nginx/debug.log custom;
    error_log /var/log/nginx/debug.log custom;

    if ($block) {
        return 403;
    }

    location / {
        # root /var/www/html;
        proxy_set_header Host $host;
        proxy_pass http://127.0.0.1:4002/;
    }

    # redirect server error pages to the static page /50x.html
    error_page   500 502 503 504  /50x.html;
    location = /50x.html {
        root   /usr/share/nginx/html;
    }
}
