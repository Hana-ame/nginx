server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name eh-web-viewer.moonchan.xyz ex.moonchan.xyz ehwv.moonchan.xyz ex.nmbyd2.top ex.nmbyd3.top ex.810114.xyz;

    # ssl configuration
    include /etc/nginx/conf.d/ssl/moonchan.xyz.conf;
    
    include /etc/nginx/conf.d/addon/no-log.conf;

    # access_log /var/log/nginx/access.log custom_log;
    # error_log /dev/null;

    location / {
        proxy_pass http://127.25.23.2:8080/;
    }

    # redirect server error pages to the static page /50x.html
    error_page   500 502 503 504  /50x.html;
    location = /50x.html {
        root   /usr/share/nginx/html;
    }
}


server {
    listen 443 ssl http2;
    server_name pkg-go-dev.moonchan.xyz;

    include /etc/nginx/conf.d/ssl/moonchan.xyz.conf;
    
    access_log /dev/null;
    error_log /dev/null;
    
    location / {
        resolver 8.8.8.8 ipv6=off;
        proxy_set_header Referer "https://pkg.go.dev/";
        proxy_set_header Host "pkg.go.dev";
        proxy_pass https://pkg.go.dev/;
    }

    # redirect server error pages to the static page /50x.html
    error_page   500 502 503 504  /50x.html;
    location = /50x.html {
        root   /usr/share/nginx/html;
    }
}

