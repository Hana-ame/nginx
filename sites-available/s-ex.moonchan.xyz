# log_format custom_log '$http_x_forwarded_for - $remote_user [$time_local] "$request" $status $body_bytes_sent "$http_referer" "$http_user_agent"';

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name s-ex.moonchan.xyz;

    # ssl configuration
    include /etc/nginx/conf.d/ssl/moonchan.xyz.conf;
    
    include /etc/nginx/conf.d/addon/no-log.conf;

    # access_log /var/log/nginx/access.log custom_log;
    # error_log /dev/null;
     
    # location / {
    #     proxy_set_header Cookie "ipb_member_id=3096156; ipb_pass_hash=7689f8ad48f6576453620a52ffa238e1; igneous=57a39d0fa; sl=dm_1; sk=939cq4lc9fccsgkh6kj8gpiyby6a; hath_perks=m1-0266e6109f; PHPSESSID=c19017a1ca0751ba3a478248faec62c0; u=3096156-0-q4gy998a1bt";
    #     proxy_set_header Referer "https://exhentai.org";
    #     # proxy_set_header Origin "https://exhentai.org";
    #     proxy_set_header Sec-Fetch-Dest "image";
    #     proxy_set_header Sec-Fetch-Mode "no-cors";
    #     proxy_set_header Sec-Fetch-Site "same-site";

    #     proxy_connect_timeout 3s;
    #     proxy_read_timeout 3s;
    #     proxy_send_timeout 3s;
    #     proxy_next_upstream error timeout;
    #     proxy_next_upstream_tries 15;

    #     proxy_pass https://s.exhentai.org/;
    # }
    location / {
        proxy_pass http://127.25.23.3:8080/;
    }

    # redirect server error pages to the static page /50x.html
    error_page   500 502 503 504  /50x.html;
    location = /50x.html {
        root   /usr/share/nginx/html;
    }
}


server {
    listen 443 ssl http2;
    server_name pkg-go-dev.moonchan.xyz;

    include /etc/nginx/conf.d/ssl/moonchan.xyz.conf;
    
    access_log /dev/null;
    error_log /dev/null;
    
    location / {
        resolver 8.8.8.8 ipv6=off;
        proxy_set_header Referer "https://pkg.go.dev/";
        proxy_set_header Host "pkg.go.dev";
        proxy_pass https://pkg.go.dev/;
    }

    # redirect server error pages to the static page /50x.html
    error_page   500 502 503 504  /50x.html;
    location = /50x.html {
        root   /usr/share/nginx/html;
    }
}

