server {
  listen 443 ssl http2;
  listen [::]:443 ssl http2;
  server_name moonchan.xyz vps.moonchan.xyz nmbyd2.top nmbyd3.top nmbyd4.top nmbyd5.top nmbyd6.top nmbyd7.top nmbyd8.top;

  # ssl configuration
  include /etc/nginx/conf.d/ssl/moonchan.xyz.conf;
  # include /etc/nginx/conf.d/ssl/hana-sweet.top.conf;

  # access_log /dev/null;
  error_log /dev/null;
  # access_log /var/log/nginx/access.log custom_log;

  include /etc/nginx/conf.d/addon/general-deny.conf;

  location / {
    add_header X-Frame-Options "ALLOWALL";
    root /var/www/moonchan;
  }

  # 精确匹配路径 /go/
  location = /go/ {
    return 302 https://moonchan.xyz/;
  }

  # location /groq {
  #   proxy_pass http://127.25.2.9:8080/;
  # }

  location /shijima/ {
    proxy_pass http://127.0.1.1:8080/api/;
  }
  location = /api/ {
    proxy_pass http://127.0.1.1:8080/api/;
  }

  location /api/v2/ {
    add_header X-Frame-Options "ALLOWALL";
    proxy_pass http://127.25.5.19:8080/api/v2/;
  }


  location = /ws/ {
    proxy_redirect off;
    proxy_pass http://127.114.5.14:8080;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";
    proxy_set_header Host $http_host;
  }

  # location = /upload {
  #   proxy_pass http://127.114.5.14:8080;
  # }

  # location = /groq {
  #   proxy_redirect off;
  #   proxy_pass http://127.24.5.3:8765/groq;
  #   proxy_http_version 1.1;
  #   proxy_set_header Upgrade $http_upgrade;
  #   proxy_set_header Connection "upgrade";
  #   proxy_set_header Host $http_host;
  # }
  include /etc/nginx/conf.d/addon/doh.conf;
  include /etc/nginx/conf.d/addon/v2ray.conf;

  # redirect server error pages to the static page /50x.html
  error_page 500 502 503 504 /50x.html;
  location = /50x.html {
    root /usr/share/nginx/html;
  }
}


server {
  listen 443 ssl http2;
  server_name doh.moonchan.xyz doh.nmbyd3.top doh.nmbyd4.top doh.nmbyd5.top doh.nmbyd6.top doh.nmbyd7.top doh.nmbyd8.top;

  # ssl configuration
  include /etc/nginx/conf.d/ssl/moonchan.xyz.conf;
  # include /etc/nginx/conf.d/ssl/hana-sweet.top.conf;

  access_log /dev/null;
  error_log /dev/null;

  # 我日这是啥？？？
  location / {
    proxy_pass http://127.25.10.17:8080/;
  }

  include /etc/nginx/conf.d/addon/doh.conf;
  include /etc/nginx/conf.d/addon/v2ray.conf;

  # redirect server error pages to the static page /50x.html
  error_page 500 502 503 504 /50x.html;
  location = /50x.html {
    root /usr/share/nginx/html;
  }
}

# upload
server {
  listen 443 ssl http2;
  server_name upload.moonchan.xyz upload.nmbyd2.top;

  # ssl configuration
  include /etc/nginx/conf.d/ssl/moonchan.xyz.conf;

  access_log /dev/null;
  error_log /dev/null;

  location / {
    add_header X-Frame-Options "ALLOWALL";
    try_files $uri $uri/ /index.html;
    root /var/www/upload;
  }

  client_body_timeout 300s;

  location /api/ {
    client_max_body_size 50m;
    proxy_pass http://127.23.12.17:8080/api/;
  }

  include /etc/nginx/conf.d/addon/v2ray.conf;

  # redirect server error pages to the static page /50x.html
  error_page 500 502 503 504 /50x.html;
  location = /50x.html {
    root /usr/share/nginx/html;
  }
}


