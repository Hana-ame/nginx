server {
    listen 443 ssl http2;
    server_name  moonchan.xyz tsukishima.top a.tsukishima.top b.tsukishima.top c.tsukishima.top d.tsukishima.top e.tsukishima.top;

    # ssl configuration
    include /etc/nginx/conf.d/ssl/moonchan.xyz.conf;
    # include /etc/nginx/conf.d/ssl/hana-sweet.top.conf;
    
    access_log /dev/null;
    error_log /dev/null;
    # access_log /var/log/nginx/access.log custom_log;

    include /etc/nginx/conf.d/addon/general-deny.conf;

    location / {
      add_header X-Frame-Options "ALLOWALL";
      root /var/www/moonchan;
    }

    location /api/ {
      proxy_pass http://127.0.1.1:8080/api/;
    }

    location /api-pack/ {
      proxy_pass http://127.111.111.111:8080/;      
    }

    location /assets/ {
      add_header Access-Control-Allow-Origin *;
      root /var/www/moonchan;
    }
    
    include /etc/nginx/conf.d/addon/doh.conf;
    include /etc/nginx/conf.d/addon/v2ray.conf;

    # redirect server error pages to the static page /50x.html
    error_page   500 502 503 504  /50x.html;
    location = /50x.html {
        root   /usr/share/nginx/html;
    }
}


server {
    listen 443 ssl http2;
    server_name  chat.moonchan.xyz;

    # ssl configuration
    include /etc/nginx/conf.d/ssl/moonchan.xyz.conf;
    # include /etc/nginx/conf.d/ssl/hana-sweet.top.conf;
    
    access_log /dev/null;
    error_log /dev/null;
     
    include /etc/nginx/conf.d/addon/general-deny.conf;

    location / {
      add_header X-Frame-Options "ALLOWALL";
      try_files $uri $uri/ /index.html;
      root /var/www/chat;
    }

    location /api/ {
      proxy_pass http://127.100.0.2:8080/api/;
    }

    include /etc/nginx/conf.d/addon/doh.conf;
    include /etc/nginx/conf.d/addon/v2ray.conf;

    # redirect server error pages to the static page /50x.html
    error_page   500 502 503 504  /50x.html;
    location = /50x.html {
        root   /usr/share/nginx/html;
    }
}


server {
    listen 443 ssl http2;
    server_name  helper.moonchan.xyz;

    # ssl configuration
    include /etc/nginx/conf.d/ssl/moonchan.xyz.conf;
    # include /etc/nginx/conf.d/ssl/hana-sweet.top.conf;
    
    access_log /dev/null;
    error_log /dev/null;
     
    include /etc/nginx/conf.d/addon/general-deny.conf;

    location / {
      proxy_pass http://127.99.0.1:8080/;
    }

    include /etc/nginx/conf.d/addon/doh.conf;
    include /etc/nginx/conf.d/addon/v2ray.conf;

    # redirect server error pages to the static page /50x.html
    error_page   500 502 503 504  /50x.html;
    location = /50x.html {
        root   /usr/share/nginx/html;
    }
}




server {
    listen 443 ssl http2;
    server_name  fedi.moonchan.xyz;

    # ssl configuration
    include /etc/nginx/conf.d/ssl/moonchan.xyz.conf;
    
    access_log /var/log/nginx/access.log custom_log;
     
    include /etc/nginx/conf.d/addon/general-deny.conf;

    location / {
      add_header X-Frame-Options "ALLOWALL";
      # try_files $uri $uri/ /index.html;
      proxy_set_header Host $host;
      proxy_pass http://127.0.0.1:3000/;
    }

    location /api/ {
      proxy_pass http://127.0.0.1:3000/api/;
      proxy_set_header Host $host;
      proxy_set_header X-Real-IP $remote_addr;
    }

    # redirect server error pages to the static page /50x.html
    error_page   500 502 503 504  /50x.html;
    location = /50x.html {
        root   /usr/share/nginx/html;
    }
}




server {
    listen 443 ssl http2;
    server_name  upload.moonchan.xyz uploads.moonchan.xyz;

    # ssl configuration
    include /etc/nginx/conf.d/ssl/moonchan.xyz.conf;
    
    access_log /var/log/nginx/access.log custom_log;
     
    include /etc/nginx/conf.d/addon/general-deny.conf;

    location / {
      add_header X-Frame-Options "ALLOWALL";
      # try_files $uri $uri/ /index.html;
      proxy_set_header Host $host;
      proxy_pass http://127.0.0.1:3030/;
    }

    # redirect server error pages to the static page /50x.html
    error_page   500 502 503 504  /50x.html;
    location = /50x.html {
        root   /usr/share/nginx/html;
    }
}

