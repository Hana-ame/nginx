server {
    listen 443 ssl http2;
    server_name  moonchan.xyz;

    # ssl configuration
    include /etc/nginx/conf.d/ssl/moonchan.xyz.conf;
    # include /etc/nginx/conf.d/ssl/hana-sweet.top.conf;
    
    access_log /dev/null;
    error_log /dev/null;
    # access_log /var/log/nginx/access.log custom_log;

    include /etc/nginx/conf.d/addon/general-deny.conf;

    location / {
      add_header X-Frame-Options "ALLOWALL";
      root /var/www/moonchan;
    }

    location /api/ {
      proxy_pass http://127.0.1.1:8080/api/;
    }

    location /api-pack/ {
      proxy_pass http://127.111.111.111:8080/;      
    }

    location /assets/ {
      add_header Access-Control-Allow-Origin *;
      root /var/www/moonchan;
    }

    location /ws/ { 
      proxy_redirect off;
      proxy_pass http://127.114.5.14:8080; 
      proxy_http_version 1.1;
      proxy_set_header Upgrade $http_upgrade;
      proxy_set_header Connection "upgrade";
      proxy_set_header Host $http_host;
    }
    
    location = /upload {
      proxy_pass http://127.114.5.14:8080;
    }


    include /etc/nginx/conf.d/addon/doh.conf;
    include /etc/nginx/conf.d/addon/v2ray.conf;

    # redirect server error pages to the static page /50x.html
    error_page   500 502 503 504  /50x.html;
    location = /50x.html {
        root   /usr/share/nginx/html;
    }
}


server {
    listen 443 ssl http2;
    server_name  matrix.moonchan.xyz;

    # ssl configuration
    include /etc/nginx/conf.d/ssl/moonchan.xyz.conf;
    # include /etc/nginx/conf.d/ssl/hana-sweet.top.conf;
    
    access_log /dev/null;
    error_log /dev/null;
     

    location / {
      proxy_pass http://127.0.0.1:8008/;
    }

    include /etc/nginx/conf.d/addon/doh.conf;
    include /etc/nginx/conf.d/addon/v2ray.conf;

    # redirect server error pages to the static page /50x.html
    error_page   500 502 503 504  /50x.html;
    location = /50x.html {
        root   /usr/share/nginx/html;
    }
}

# upload
server {
    listen 443 ssl http2;
    server_name upload.moonchan.xyz;

    # ssl configuration
    include /etc/nginx/conf.d/ssl/moonchan.xyz.conf;
    
    access_log /dev/null;
    error_log /dev/null;
     
    location / {
      add_header X-Frame-Options "ALLOWALL";
      try_files $uri $uri/ /index.html;
      root /var/www/upload;
    }

    location /api/ {
      client_max_body_size 20m;
      proxy_pass http://127.23.12.17:8080/api/;
    }

    include /etc/nginx/conf.d/addon/v2ray.conf;

    # redirect server error pages to the static page /50x.html
    error_page   500 502 503 504  /50x.html;
    location = /50x.html {
        root   /usr/share/nginx/html;
    }
}



