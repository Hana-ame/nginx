# 不使用

server {
    listen 443 ssl http2;
    server_name piped.moonchan.xyz  ; # For all 3 hostnames
    include /etc/nginx/conf.d/ssl/moonchan.xyz.conf;

    # access_log /dev/null;
    error_log /dev/null;
     
    location / {
       proxy_pass http://127.0.0.1:8088;
       proxy_set_header Host $host;
    }
}
