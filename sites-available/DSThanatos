server {
  listen 443 ssl http2;
  server_name  dsthanatos.moonchan.xyz;

  # ssl configuration
  include /etc/nginx/conf.d/ssl/moonchan.xyz.conf;
  
  access_log /dev/null;
  error_log /dev/null;
  # access_log /var/log/nginx/access.log custom_log;

  include /etc/nginx/conf.d/addon/general-deny.conf;

  autoindex on;

  location / {
    add_header X-Frame-Options "ALLOWALL";
    root /var/www/moonchan/DSThanatos;
  }

  location /ws/ { 
    proxy_redirect off;
    proxy_pass http://127.114.5.14:8080; 
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";
    proxy_set_header Host $http_host;
  }
  
  location /upload {
    proxy_pass http://127.114.5.14:8080;
  }

  include /etc/nginx/conf.d/addon/doh.conf;
  include /etc/nginx/conf.d/addon/v2ray.conf;

  # redirect server error pages to the static page /50x.html
  error_page   500 502 503 504  /50x.html;
  location = /50x.html {
      root   /usr/share/nginx/html;
  }
}
