server {

	listen 80 http2;
	listen [::]:80 http2;
  
  server_name moonchan.xyz;

  access_log /dev/null;
	error_log /dev/null;

  root /var/www/html;

  index index.html index.htm index.nginx-debian.html;

  location /ws/ { #/ray 路径需要和v2ray服务器端，客户端保持一致
    proxy_redirect off;
    proxy_pass http://127.114.5.14:8080; #此IP地址和端口需要和v2ray服务器保持一致，
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";
    proxy_set_header Host $http_host;
  }
}